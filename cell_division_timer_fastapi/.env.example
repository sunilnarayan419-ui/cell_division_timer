# ==============================================================================
# Cell Division Timer - Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME="Cell Division Timer API"
APP_ENV=development
DEBUG=True
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Database Configuration
# Default: Local SQLite database
DATABASE_URL=sqlite:///./cell_division.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cell_division_db

# Security & CORS
CORS_ORIGINS=["*"]
ALLOWED_HOSTS=["*"]

# Logging
LOG_LEVEL=INFO

# ============================================================
# NCBI / PubMed
# ============================================================

NCBI_API_KEY=
NCBI_TOOL=cell_division_timer
NCBI_EMAIL=

