# ==============================================================================
# Cell Division Timer - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and fill in your own values.
# Never commit a real `.env` file or paste secrets into this template.

# ------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------
APP_NAME="Cell Division Timer API"
APP_ENV=development
DEBUG=True
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------
# Default: local SQLite database (no setup required)
DATABASE_URL=sqlite:///./cell_division.db
# For PostgreSQL (e.g. via docker-compose):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cell_division_db

# ------------------------------------------------------------------
# Security & CORS
# ------------------------------------------------------------------
CORS_ORIGINS=["*"]

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------
LOG_LEVEL=INFO

# ------------------------------------------------------------------
# NCBI / PubMed E-utilities
# ------------------------------------------------------------------
# Get a free API key at: https://www.ncbi.nlm.nih.gov/account/settings/
# The key raises your NCBI rate limit and is REQUIRED for literature search.
# Leave empty to run the rest of the app without literature search enabled.
NCBI_API_KEY=YOUR_NCBI_API_KEY_HERE
NCBI_TOOL=cell_division_timer
NCBI_EMAIL=your_email@example.com
NCBI_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
NCBI_DEFAULT_RETMAX=10
NCBI_TIMEOUT=30
